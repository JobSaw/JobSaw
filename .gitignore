# Environment secrets
.env
.env.*
!.env.example

# Output files
/output/
/temp_output/

# Templates contents: keep folder structure but ignore actual template files
/templates/CV/*
!/templates/CV/
!/templates/CV/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyc
venv/
.venv/
*.egg-info/
build/
dist/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# VSCode
.vscode/

# OS
.DS_Store
Thumbs.db

# Personal user data: keep the folder but do not commit JSON files containing PII
user_data/*.json
!user_data/.gitkeep
